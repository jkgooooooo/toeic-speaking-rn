{
  "expo": {
    "name": "speaking",
    "slug": "speaking-rn",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "speakingrn",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.speaking.practice.dev"
    },
    "android": {
      "package": "com.speaking.practice.dev",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDFBF8",
          "dark": {
            "backgroundColor": "#1B181E"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "말하기 연습의 답변을 녹음하고 다시 듣기 위해 마이크를 사용해요.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
